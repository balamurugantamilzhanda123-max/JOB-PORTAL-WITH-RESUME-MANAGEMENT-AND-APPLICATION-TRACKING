# ==============================================================================
# TalentForge ATS - Environment Configuration
# Copy this file to .env (root and/or backend/.env) and fill in strong secrets.
# NEVER commit real secrets or production credentials to version control.
#
# Generate strong 64-byte hex secrets using:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ==============================================================================

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ats_platform?schema=public

# JWT Secrets (minimum 32 characters required; use 64+ random bytes in production)
JWT_ACCESS_SECRET=replace-with-64-char-random-hex-access-secret-for-local-dev-only
JWT_REFRESH_SECRET=replace-with-64-char-random-hex-refresh-secret-for-local-dev-only

# Token Lifetimes
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Secure Admin Bootstrap Credentials (used exclusively by prisma seed script)
ADMIN_EMAIL=admin@talentforge.local
ADMIN_PASSWORD=ChangeMe!Admin123$
ADMIN_FULL_NAME=Platform Administrator

# Runtime Environment (development | test | production)
NODE_ENV=development
PORT=4000

